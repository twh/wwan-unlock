# Bind the option usb-serial driver to the Rolling RW101R-GL.
#
# The FCC challenge on this module answers only on its serial AT port, so the
# option driver must have claimed the device. Linux 6.18 added 33f8:01a8, 01a9,
# 0301 and 0302 to that driver's id table in commit 523bf0a59e67, also present
# in the stable backports; only 33f8:01a4 is older. On an earlier kernel the
# driver never binds, no /dev/ttyUSB is created, and the unlock cannot run.
#
# Harmless on a newer kernel: the driver already matches these ids by modalias,
# and writing an id it already knows is a no-op. The modprobe is folded into the
# rule because /sys/bus/usb-serial/drivers/option1/ does not exist until the
# option module is loaded, so a rule that only writes new_id races the module
# load at boot.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="33f8", ATTR{idProduct}=="01a8", \
  RUN+="/bin/sh -c '/sbin/modprobe option; echo 33f8 01a8 > /sys/bus/usb-serial/drivers/option1/new_id'"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="33f8", ATTR{idProduct}=="01a9", \
  RUN+="/bin/sh -c '/sbin/modprobe option; echo 33f8 01a9 > /sys/bus/usb-serial/drivers/option1/new_id'"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="33f8", ATTR{idProduct}=="0301", \
  RUN+="/bin/sh -c '/sbin/modprobe option; echo 33f8 0301 > /sys/bus/usb-serial/drivers/option1/new_id'"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="33f8", ATTR{idProduct}=="0302", \
  RUN+="/bin/sh -c '/sbin/modprobe option; echo 33f8 0302 > /sys/bus/usb-serial/drivers/option1/new_id'"
