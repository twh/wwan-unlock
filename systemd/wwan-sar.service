[Unit]
Description=WWAN RF/SAR configuration (gate-free, via wwan-orch)
After=ModemManager.service
Wants=ModemManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /dev/wwan0mbim0 ] || [ -e /dev/cdc-wdm0 ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/local/lib/wwan-unlock/wwan-sar-boot.sh
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
